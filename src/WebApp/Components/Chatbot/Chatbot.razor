@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.AI
@using System.Threading
@using eShop.WebApp.Chatbot
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CatalogService CatalogService
@inject IProductImageUrlProvider ProductImages
@inject BasketState BasketState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILoggerFactory LoggerFactory
@inject IServiceProvider ServiceProvider

<div class="floating-pane">
    <a href="@Nav.GetUriWithQueryParameter("chat", (string?)null)" class="hide-chatbot" title="Close .NET Concierge"><span>✖</span></a>

    <div class="chatbot-chat" @ref="chat">
        @if (chatState is not null)
        {
            foreach (var message in chatState.Messages.Where(m => m.Role == ChatRole.Assistant || m.Role == ChatRole.User))
            {
                if (!string.IsNullOrEmpty(message.Text))
                {
                    <p @key="@message" class="message message-@message.Role">
                        @foreach (var part in MessageProcessor.ParseMessage(message.Text))
                        {
                            if (part is TextMessagePart textPart)
                            {
                                @((MarkupString)MessageProcessor.FormatMarkdownText(textPart.Text))
                            }
                            else if (part is ImageMessagePart imagePart)
                            {
                                <img title="@imagePart.Alt" src="@imagePart.Url" alt="@imagePart.Alt" />
                            }
                            else if (part is LinkMessagePart linkPart)
                            {
                                <a href="@linkPart.Url" class="chat-link">@linkPart.Text</a>
                            }
                            else if (part is AddToCartButtonMessagePart cartPart)
                            {
                                <button type="button" class="chat-btn-add-to-cart" @onclick="() => AddToCartAsync(cartPart.ItemId)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
                                        <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                                    </svg>
                                    @cartPart.ItemName
                                </button>
                            }
                        }
                    </p>
                }
            }
        }
        else if (missingConfiguration)
        {
            <p class="message message-assistant"><strong>The chatbot is missing required configuration.</strong> Please set 'useOpenAI = true' in eShop.AppHost/Program.cs. You'll need an API key or an Azure Subscription to enable AI features.</p>
        }

        @if (thinking && (chatState?.Messages.LastOrDefault() is not { } lastMsg || lastMsg.Role != ChatRole.Assistant || string.IsNullOrEmpty(lastMsg.Text)))
        {
            <p class="thinking">Thinking...</p>
        }
    </div>

    <form class="chatbot-input" @onsubmit="SendMessageAsync">
        <textarea placeholder="@(thinking ? "AI is thinking..." : "Start chatting...")" 
                  @ref="@textbox" 
                  @bind="messageToSend" 
                  @bind:event="oninput"
                  disabled="@(chatState is null || thinking)"></textarea>
        @if (thinking)
        {
            <button type="button" class="btn-stop" title="Stop" @onclick="StopGeneration">Stop</button>
        }
        else
        {
            <button type="submit" title="Send" disabled="@(chatState is null || string.IsNullOrWhiteSpace(messageToSend))">Send</button>
        }
    </form>
</div>

@code {
    bool missingConfiguration;
    ChatState? chatState;
    ElementReference textbox;
    ElementReference chat;
    string? messageToSend;
    bool thinking;
    IJSObjectReference? jsModule;
    CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        var client = ServiceProvider.GetService<IChatClient>();
        if (client is not null)
        {
            AuthenticationState auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            chatState = new ChatState(CatalogService, BasketState, auth.User, ProductImages, LoggerFactory, client);
            await chatState.InitializeAsync();
        }
        else
        {
            missingConfiguration = true;
        }
    }

    private void StopGeneration()
    {
        cts?.Cancel();
        thinking = false;
        StateHasChanged();
    }

    private async Task SendMessageAsync()
    {
        if (thinking)
        {
            return;
        }

        var messageCopy = messageToSend?.Trim();
        messageToSend = null;

        if (chatState is not null && !string.IsNullOrEmpty(messageCopy))
        {
            thinking = true;
            cts = new CancellationTokenSource();
            try
            {
                await chatState.AddUserMessageAsync(messageCopy, onMessageAdded: StateHasChanged, cts.Token);
            }
            catch (OperationCanceledException)
            {
                // Handled cancellation
            }
            finally
            {
                thinking = false;
                cts?.Dispose();
                cts = null;
                StateHasChanged();
                await textbox.FocusAsync();
            }
        }
    }

    private async Task AddToCartAsync(int itemId)
    {
        try
        {
            var item = await CatalogService.GetCatalogItem(itemId);
            if (item is not null)
            {
                await BasketState.AddAsync(item);
            }
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("Chatbot").LogError(ex, "Failed to add item to cart from chatbot");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Chatbot/Chatbot.razor.js");
        await jsModule.InvokeVoidAsync("scrollToEnd", chat);

        if (firstRender)
        {
            await textbox.FocusAsync();
            await jsModule.InvokeVoidAsync("submitOnEnter", textbox);
        }
    }
}
