### 1. WebApp Components & Services

#### [MODIFY] [MessageProcessor.cs](file:///d:/Subagent/Nhom_10_DevOps_Testing_Production/eShop-main/src/WebApp/Components/Chatbot/MessageProcessor.cs)
Thay đổi bộ xử lý tin nhắn để phân tích tin nhắn Markdown thành một danh sách các phần tử (Parts) riêng biệt, hỗ trợ hình ảnh, liên kết, nút và văn bản thuần túy một cách an toàn thay vì chỉ thay thế thẻ `<img>` thô.

```csharp
using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;

namespace eShop.WebApp.Chatbot;

public abstract record ChatMessagePart;
public record TextMessagePart(string Text) : ChatMessagePart;
public record ImageMessagePart(string Alt, string Url) : ChatMessagePart;
public record LinkMessagePart(string Text, string Url) : ChatMessagePart;
public record AddToCartButtonMessagePart(int ItemId, string ItemName) : ChatMessagePart;

public static partial class MessageProcessor
{
    private static readonly Regex MarkdownRegex = new(@"(!?)\[([^\]]+)\]\s*\(([^)]+)\)", RegexOptions.Compiled);

    public static List<ChatMessagePart> ParseMessage(string message)
    {
        var parts = new List<ChatMessagePart>();
        if (string.IsNullOrEmpty(message))
        {
            return parts;
        }

        var matches = MarkdownRegex.Matches(message);
        int lastIndex = 0;

        foreach (Match match in matches)
        {
            if (match.Index > lastIndex)
            {
                parts.Add(new TextMessagePart(message.Substring(lastIndex, match.Index - lastIndex)));
            }

            string isImage = match.Groups[1].Value;
            string text = match.Groups[2].Value;
            string urlOrAction = match.Groups[3].Value;

            if (!string.IsNullOrEmpty(isImage))
            {
                parts.Add(new ImageMessagePart(text, urlOrAction));
            }
            else if (urlOrAction.StartsWith("submit:add-to-cart:", StringComparison.OrdinalIgnoreCase))
            {
                var idStr = urlOrAction.Substring("submit:add-to-cart:".Length);
                if (int.TryParse(idStr, out int itemId))
                {
                    parts.Add(new AddToCartButtonMessagePart(itemId, text));
                }
                else
                {
                    parts.Add(new LinkMessagePart(text, urlOrAction));
                }
            }
            else if (urlOrAction.StartsWith("add-to-cart:", StringComparison.OrdinalIgnoreCase))
            {
                var idStr = urlOrAction.Substring("add-to-cart:".Length);
                if (int.TryParse(idStr, out int itemId))
                {
                    parts.Add(new AddToCartButtonMessagePart(itemId, text));
                }
                else
                {
                    parts.Add(new LinkMessagePart(text, urlOrAction));
                }
            }
            else
            {
                parts.Add(new LinkMessagePart(text, urlOrAction));
            }

            lastIndex = match.Index + match.Length;
        }

        if (lastIndex < message.Length)
        {
            parts.Add(new TextMessagePart(message.Substring(lastIndex)));
        }

        return parts;
    }
}
```

